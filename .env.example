# Copy to .env on the Pi. Never commit real keys.
# The script loads .env from its own folder; process environment variables take precedence.
AZURE_AUTH_MODE=key
# For unattended Entra authentication, use AZURE_AUTH_MODE=entra and set the
# following four values instead of AZURE_OPENAI_API_KEY / AZURE_SPEECH_KEY:
# AZURE_TENANT_ID=YOUR_TENANT_ID
# AZURE_CLIENT_ID=YOUR_APPLICATION_ID
# AZURE_CLIENT_SECRET=YOUR_APPLICATION_SECRET
# AZURE_SPEECH_ENDPOINT=https://YOUR-SPEECH-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_DEPLOYMENT=chuckles-chat
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SPEECH_KEY=REPLACE_ME
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-GuyNeural
AZURE_SPEECH_STYLE=angry
GPIO_CHIP=gpiochip4
ROCK_PIN=14
GPIO_ENABLED=true
# Delay before listening again after playback (Bluetooth buffering / room echo).
AUDIO_SETTLE_SECONDS=0.75
# Fresh, in-memory webcam snapshot for each visitor prompt (requires fswebcam).
# Set false for audio-only operation. No camera captures for quit/new visitors.
CAMERA_ENABLED=true
CAMERA_DEVICE=/dev/video0
# Password-free phone preview: trusted LAN only, never port-forward the web app.
# Retains only the latest JPEG in RAM for 60 seconds. False restores no preview retention.
CAMERA_PREVIEW_ENABLED=true
# Loopback-only speech service; the Flask process reads the same port from .env.
CAMERA_PREVIEW_PORT=8765
